# catapult.toml — release configuration for a Swift macOS app.
# Copy to <app-repo>/catapult.toml and edit for each app.

[app]
name        = "MyApp"                       # display name, .app bundle, executable
slug        = "myapp"                       # lowercase, URL/filename segment
bundle_id   = "com.example.myapp"
team_id     = "556XHQJK3G"
developer   = "Douglas Lassance"           # signing identity name
homepage    = "https://example.com/myapp"
description = "Short tagline"              # used in Homebrew cask `desc`
category    = "public.app-category.productivity"
min_macos   = "13.0"

[build]
kind          = "swift"                    # "swift" (default) or "tauri"
arch          = "arm64"                    # passed to `swift build --arch`
target_triple = "aarch64-apple-darwin"     # used in DMG filename + URLs
swift_target  = "App"                      # SPM target name; resource bundle is "${name}_${swift_target}.bundle"
# Optional overrides (defaults shown):
# executable            = "${name}"        # binary name in .build/release; set if it differs from app.name
# icon                  = "Sources/App/Resources/AppIcon.png"
# icon_command          = "swift render_icon.swift build/icon.iconset && iconutil -c icns build/icon.iconset -o build/AppIcon.icns"
# assets                = "Sources/App/Resources/Assets.xcassets"
# entitlements_direct   = "${name}.entitlements"
# entitlements_appstore = "${name}-appstore.entitlements"
# provisioning_profile  = "${name}.provisionprofile"   # filename in ~/Library/MobileDevice/Provisioning Profiles/

# For kind = "tauri", instead of swift_target use:
# package_manager     = "bun"              # "bun", "pnpm", "yarn", or "npm"
# platform            = "desktop"          # also Windows and Linux, see below
# tauri_dir           = "src-tauri"        # default
# frontend_build      = "bun run build"    # default = "${package_manager} run build"

# --- iOS apps ---------------------------------------------------------------
# iOS is Xcode-driven: xcodebuild archives and exports the .ipa, so most macOS
# fields above (arch, target_triple, min_macos, swift_target, entitlements,
# icon) do NOT apply — the Xcode project owns all of that. Set:
#
# [build]
# kind        = "xcodeproj"
# platform    = "ios"
# scheme      = "MyApp"                     # xcodebuild -scheme
# project     = "MyApp.xcodeproj"           # OR workspace = "MyApp.xcworkspace"
# configuration = "Release"                 # default
# pregenerate = "xcodegen generate"         # optional hook run before archiving
#                                           # (use when the .xcodeproj is generated + gitignored)
#
# iOS apps ship only through the [appstore] channel; s3/homebrew/sparkle/dmg
# are macOS-only and are ignored. Uploading to App Store Connect is what makes
# a build available in TestFlight. ITSAppUsesNonExemptEncryption must be set in
# the app's own Info.plist (Xcode owns the plist for iOS).
#
# Add [testflight] to also distribute each build, not just upload it (see the
# section at the bottom of this file).

# --- Android apps -------------------------------------------------------------
# Android is Gradle-driven: the app's own build produces and signs the .aab, so
# none of the Apple fields apply and team_id / developer can be left out.
# bundle_id is the applicationId. Set:
#
# [build]
# kind     = "gradle"
# platform = "android"
# module   = "app"                         # default; the Gradle module to build
# task     = "bundleRelease"               # default
# bundle   = "app/build/outputs/bundle/release/app-release.aab"   # default, from module
# pregenerate = "..."                      # optional hook run before building
#
# Android apps ship only through the [play] channel. Signing stays in the app's
# Gradle config (a gitignored keystore.properties holding the upload key), and
# build_android.sh refuses a bundle that comes out unsigned.
#
# catapult hands the version to Gradle as environment variables, so the app's
# build.gradle.kts should prefer them and fall back to its own values:
#
#   versionName = System.getenv("CATAPULT_VERSION") ?: "1.0.0"
#   versionCode = System.getenv("CATAPULT_BUILD_NUMBER")?.toInt() ?: 1
#
# CATAPULT_BUILD_NUMBER is the latest commit's Unix timestamp, the same build
# number the Apple paths use, which only ever increases as Play requires.

# --- Tauri mobile apps --------------------------------------------------------
# A Tauri app can ship on iOS and Android from one repo, and release both under
# one version. `tauri ios build` and `tauri android build` drive the Xcode and
# Gradle projects Tauri generated under src-tauri/gen, so the Apple and Android
# fields above do not apply. Set:
#
# [build]
# kind            = "tauri"
# platforms       = ["ios", "android"]     # instead of platform
# package_manager = "pnpm"
# tauri_dir       = "src-tauri"            # default
# bundle          = "src-tauri/gen/android/app/build/outputs/bundle/universalRelease/app-universal-release.aab"   # default
#
# Each platform takes the channel it always takes: [appstore] (plus
# [testflight]) for iOS and [play] for Android. release.sh builds and publishes
# them in turn, with the same version and the same build number, which catapult
# passes to Tauri as the iOS bundleVersion and the Android versionCode.
#
# Android signing stays in the generated app/build.gradle.kts, which should read
# the upload key from a gitignored keystore.properties. The Tauri CLI needs
# ANDROID_HOME and NDK_HOME; catapult defaults them to Android Studio's SDK
# folder and its newest NDK.

# --- Compose desktop apps -----------------------------------------------------
# Compose Multiplatform desktop apps build with Gradle and jpackage, which only
# targets the OS it runs on. Each host makes its own artifacts (a DMG on macOS,
# an MSI on Windows, a DEB and an AppImage on Linux), and catapult derives the
# target triple from the host, so leave arch and target_triple unset.
#
# [build]
# kind          = "compose"                # platform defaults to "desktop"
# gradle_module = "composeApp"             # default
# icon_assets   = "composeApp/icons/Assets.car"   # optional, macOS adaptive icon
# linux_icon    = "composeApp/icons/icon.png"     # default, from gradle_module
#
# Gradle gets the version as -Papp.version. team_id, developer and min_macos are
# only required on a Mac, where catapult stamps the version and min_macos into
# the Info.plist jpackage wrote, merges [plist.extras], [plist.usage_descriptions]
# and [plist.env] into it, and signs every native (inside jars too) with the
# entitlements file. An adaptive icon wants CFBundleIconName = "AppIcon" in
# [plist.extras] next to icon_assets.
#
# Only the Mac records the release, which keeps the version's extension .dmg
# for the Homebrew cask. Homebrew runs only on a Mac, and the MSI is
# Authenticode signed when WINDOWS_CERTIFICATE is set (see env.example).

# --- Tauri desktop apps -------------------------------------------------------
# A Tauri app builds on macOS, Windows and Linux like a Compose app, and makes
# the same artifacts, with:
#
# [build]
# kind            = "tauri"
# platform        = "desktop"              # no arch or target_triple, the host decides
# package_manager = "bun"
#
# Each host runs `tauri build` for its own bundles (app, msi, or deb and
# appimage). With bundle.createUpdaterArtifacts, the updater manifest
# ${slug}.json lists every host's bundle with its signature, so every host needs
# TAURI_SIGNING_PRIVATE_KEY (see env.example).

# --- Optional channels --- presence of each section enables that channel.

[sparkle]                                  # embed Sparkle in direct build + sign DMG
# Requires `import Sparkle` in Package.swift and SPUStandardUpdaterController
# wired in the app. Without that dependency the build script warns and skips
# embedding — the [sparkle] section alone doesn't pull Sparkle in.
feed_url = "https://example.com/myapp/myapp.xml"

[dmg]                                      # always on for direct builds, but lets you set the volume name
volume_name = "MyApp"

[s3]                                       # upload DMG / appcast / KV to S3-compatible storage (Cloudflare R2, AWS S3, etc.)
bucket_prefix         = "myapp"             # objects land at s3://${bucket}/${bucket_prefix}/
appcast_filename      = "myapp.xml"
download_url_template = "https://example.com/myapp/download/{version}/{target}"
# kv_key = "myapp"                          # defaults to slug

[homebrew]                                 # push a cask update to a Homebrew tap
cask_name = "myapp"
# cask_template = "cask.rb"                # path relative to app repo (default)

[appstore]                                 # build .pkg + upload to App Store Connect
non_exempt_encryption = false

# [testflight]                             # iOS only — distribute after uploading
# groups = ["Friends"]                     # beta group names, exactly as in ASC
# submit_for_review = true                 # default; external groups require it
# timeout = 1200                           # seconds to wait for processing
#
# Without this section catapult uploads the build and stops, leaving you to set
# "What to Test" and assign groups by hand in App Store Connect. With it,
# release.sh waits for processing, writes What to Test from the commit subjects
# since the previous tag, attaches the groups, and submits for Beta App Review.
#
# Beta App Review is only skipped for later builds within a version train that
# was already reviewed. catapult mints a new marketing version per release, so
# in practice every release needs the submission.
#
# The App Store Connect API key needs App Manager (or Admin) to submit for beta
# review; an upload-only Developer key gets a 403 on that step.

# [play]                                   # Android only, publish to Google Play
# track    = "internal"                    # default; "alpha", "beta" or "production"
# status   = "completed"                   # default; "draft" leaves rollout to Play Console
# language = "en-US"                       # default; language of the release notes
#
# release.sh builds the bundle, uploads it, points the track at it and commits,
# with release notes from the commit subjects since the previous tag (trimmed to
# Play's 500 character limit). On the internal track testers get it right away.
#
# Needs PLAY_SERVICE_ACCOUNT_JSON in .env: a Google Cloud service account, with
# the Google Play Android Developer API enabled, invited in Play Console under
# Users and permissions with "Release apps to testing tracks" (and "Release to
# production" for that track). One service account serves every app on the
# developer account. Play only takes API uploads once an app has had its first
# build uploaded by hand, and only "draft" releases until one has been rolled out.

# Two modes for the Info.plist:
#
# A) Generated (default) — built from catapult.toml fields. List usage
#    descriptions and any extra string/bool/int keys here.
[plist.usage_descriptions]
NSDesktopFolderUsageDescription   = "MyApp needs access to your Desktop folder."
NSDocumentsFolderUsageDescription = "MyApp needs access to your Documents folder."

# [plist.extras]
# LSUIElement = true
#
# Either mode can also take string keys from the environment, for values that
# must not be committed. Each maps an Info.plist key to the variable holding it,
# usually set in .env, and the build stops if the variable is missing.
#
# [plist.env]
# MyAppAPIToken = "MYAPP_API_TOKEN"
#
# B) Passthrough — point at an existing Info.plist in the app repo. Trigger
#    only injects CFBundleShortVersionString / CFBundleVersion / Sparkle keys
#    / ITSAppUsesNonExemptEncryption and preserves everything else (document
#    types, UTI declarations, custom keys). Use this when the app has
#    structures the generator can't produce.
#
# [plist]
# template = "Info.plist"
